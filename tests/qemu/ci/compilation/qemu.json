{
  "common": {
    "configure": [
      "--target-list=x86_64-softmmu,aarch64-softmmu",
      "--with-devices-aarch64=rasdaemon-ci",
      "--prefix=/opt/qemu",
      "--disable-docs",
      "--disable-werror",
      "--enable-strip"
    ],
    "arm_devices": [
      "include default.mak",
      "CONFIG_PCI_IPMI_KCS=y",
      "CONFIG_IPMI_LOCAL=y"
    ]
  },
  "architectures": {
    "x86_64": {},
    "aarch64": {}
  }
}
