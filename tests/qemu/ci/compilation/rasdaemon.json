{
  "common": {
    "meson": [
      "--prefix=/usr",
      "-Dsqlite3=enabled",
      "-Denable-arch=all",
      "-Dpcie-edpc=enabled",
      "-Dbmc-generic=enabled"
    ]
  },
  "architectures": {
    "x86_64": {
      "meson": [
        "-Dmysql=enabled",
        "-Dpostgresql=enabled"
      ]
    },
    "aarch64": {
      "meson": [
        "-Dmysql=disabled",
        "-Dpostgresql=disabled"
      ]
    }
  }
}
